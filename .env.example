# Copy to .env to override. Every value here has a working default, so the
# project runs with no .env at all.

# Signs the demo session cookie. Change it for anything beyond a local demo.
TREASUREIQ_SECRET=treasureiq-demo-not-secret

# Which LLM backend serves extraction/chat: "ollama" (default, local, no
# key needed) or "anthropic" (needs ANTHROPIC_API_KEY below).
TREASUREIQ_LLM_PROVIDER=ollama

# Only read when TREASUREIQ_LLM_PROVIDER=ollama. Defaults assume a daemon on
# localhost; in compose this is overridden to reach the host via
# host.docker.internal.
OLLAMA_BASE_URL=http://localhost:11434
TREASUREIQ_OLLAMA_MODEL_EXTRACT=qwen3:14b
TREASUREIQ_OLLAMA_MODEL_CHAT=qwen3:4b

# Only required when TREASUREIQ_LLM_PROVIDER=anthropic. The committed
# extraction cache means the application runs fully without it.
ANTHROPIC_API_KEY=


# Only read by the ingestion CLI (treasureiq.ingest.websearch), never by
# the API at runtime. Points at the SearXNG instance started with
# `docker compose --profile ingest up searxng` (D-28).
SEARXNG_URL=http://localhost:8080
