# --- Python ---
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Node / Next.js ---
node_modules/
.next/
out/
next-env.d.ts
*.tsbuildinfo
.npm/

# --- Secrets and local environment ---
# Real credentials never enter the repository. `.env.example` is committed as
# documentation of which variables exist; anything holding actual values is not.
.env
.env.*
!.env.example
.secrets
.envrc
*.pem
*.key

# --- Tooling state (per-machine, not part of the project) ---
.codegraph/
.serena/
.kapi/*
# La spec è il documento di progetto: le decisioni (D-xx) e i vincoli vivono
# lì, e senza versionarla il perché delle scelte resta fuori dalla storia.
!.kapi/spec.md
.claude/

# --- OS / editor ---
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# --- Runtime artefacts ---
*.log
.coverage
htmlcov/
models/

# --- Sito vetrina generato ---
# La sorgente del sito (site/build.py, site/vetrina.html, site/assets/) è
# tracciata; l'HTML costruito no — lo rigenera GitHub Actions a ogni push.
site/_site/
site/_preview/

# NOTE: data/seed/ and data/extraction-cache/ are deliberately NOT ignored.
# They are the committed snapshots that let anyone clone the repository and run
# the full demo with no network access and no API key — which the hackathon
# requires and which is the point of the reproducibility argument.
# D-33: dati acquisiti a runtime, mai versionati.
# I dati curati stanno in data/, che è tracciata.
# feedback.jsonl (D-06) e' il primo store col testo libero del cittadino:
# non deve mai finire in git, per questo vive in data-live/ e non in data/.
data-live/
data/feedback.jsonl

# Catture di rete (HAR): decine di megabyte di traffico registrato, utili per
# capire l'API di una piattaforma e inutili da conservare. Quello che si e'
# imparato da una cattura sta nel codice — vedi `ingest/myportal.py`.
*.har

# Backup locali (make backup): storico.db + data-live/, mai versionati.
backups/

# video sorgente di presentazione (pesante): sul sito va la versione compressa in site/assets/
TreasureIQ_low.mp4
