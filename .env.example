# Copy to .env to override. Every value here has a working default, so the
# project runs with no .env at all.

# Signs the demo session cookie. Change it for anything beyond a local demo.
TREASUREIQ_SECRET=treasureiq-demo-not-secret

# Only required to re-run LLM extraction against sources that changed. The
# committed extraction cache means the application runs fully without it.
ANTHROPIC_API_KEY=
